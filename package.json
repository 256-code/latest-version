{
  "name": "inpulse-workspace",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @inpulse/web dev",
    "build": "pnpm --filter @inpulse/web build",
    "preview": "pnpm --filter @inpulse/web preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @inpulse/web test",
    "e2e": "pnpm --filter @inpulse/e2e test",
    "e2e:install": "pnpm --filter @inpulse/e2e install:browsers"
  }
}
